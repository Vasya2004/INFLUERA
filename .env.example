# Supabase (https://supabase.com/dashboard → Project Settings → API)
# Скопируйте в .env и подставьте свои значения.
# Только Project URL, БЕЗ /rest/v1 в конце
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# В Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: http://localhost:5173
#   Redirect URLs: http://localhost:5173, http://localhost:5173/reset-password
#
# Для production добавьте URL вашего домена на Vercel.

# Для Vercel: те же переменные в Project → Settings → Environment Variables
